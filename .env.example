# Public web configuration. These values are embedded in the browser build.
VITE_API_ORIGIN=https://api.example.com
VITE_WS_ORIGIN=wss://api.example.com

# API-only configuration. Origins must not include paths, queries, fragments, or wildcards.
PUBLIC_API_ORIGIN=https://api.example.com
# Use a comma-separated list of exact origins for active web deployments.
ALLOWED_WEB_ORIGINS=https://app.example.com,https://preview.example.com
PORT=10000

# Neon PostgreSQL. DATABASE_URL is pooled; DATABASE_DIRECT_URL is direct. Supply real values
# through the deployment secret store and never expose them to the browser or logs.
DATABASE_URL=postgresql://user:password@pooled-host/database?sslmode=require
DATABASE_DIRECT_URL=postgresql://user:password@direct-host/database?sslmode=require

# Authentication secrets are configured in a later commit.
BETTER_AUTH_SECRET=replace-with-a-secret
GITHUB_CLIENT_ID=replace-with-a-client-id
GITHUB_CLIENT_SECRET=replace-with-a-client-secret
