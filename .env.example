# Public web configuration. These values are embedded in the browser build.
VITE_API_ORIGIN=https://api.example.com
VITE_WS_ORIGIN=wss://api.example.com

# API-only configuration. Origins must not include paths, queries, fragments, or wildcards.
PUBLIC_API_ORIGIN=https://api.example.com
# Production requires the single PUBLIC_API_ORIGIN; development can list exact origins.
ALLOWED_WEB_ORIGINS=https://api.example.com
PORT=10000

# Neon PostgreSQL. DATABASE_URL is pooled; DATABASE_DIRECT_URL is direct. Supply real values
# through the deployment secret store and never expose them to the browser or logs.
DATABASE_URL=postgresql://user:password@pooled-host/database?sslmode=require
DATABASE_DIRECT_URL=postgresql://user:password@direct-host/database?sslmode=require

# Bounded independent pools. Values shown are the validated defaults.
TYPEORM_POOL_MAX=10
BETTER_AUTH_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=10000
BETTER_AUTH_IDLE_TIMEOUT_MS=30000

# Better Auth requires at least 32 characters. Production GitHub OAuth requires an actual
# client ID and secret from a GitHub OAuth application. These placeholders fail validation.
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
GITHUB_CLIENT_ID=replace-with-a-client-id
GITHUB_CLIENT_SECRET=replace-with-a-client-secret

# Server-only AI. Blank AI_ENABLED means disabled; enable only with all required settings.
# Never prefix any of these variables with VITE_. No AI credentials reach the browser.
AI_ENABLED=
AI_PROVIDER=
AI_MODEL=
# Operator-owned bounded JSON profile array; see docs/ai-operator-configuration.md.
AI_MODEL_PROFILES=
AI_CONFIG_VERSION=
AI_DEPLOYMENT_NAMESPACE=
OPENAI_API_KEY=
# Distinct 32-byte random keys encoded as 64 hex characters; use the secret store.
AI_CACHE_KEY_SECRET=
AI_CONTENT_ENCRYPTION_KEY=
AI_CONTENT_KEY_VERSION=
# Optional positive integer micro-USD ceilings. Defaults: $1/day, $5/month, $10 lifetime/global.
# Blank values use finite defaults; explicit values cannot use decimals/exponents.
AI_DAILY_BUDGET_MICRO_USD=
AI_MONTHLY_BUDGET_MICRO_USD=
AI_GLOBAL_BUDGET_MICRO_USD=
# Optional positive per-actor daily ceiling.
AI_ACTOR_DAILY_BUDGET_MICRO_USD=
# Optional application ceilings: 2 requests/min, 60000 input tokens/min, 10000 output tokens/min.
# These defaults do not establish the provider account's actual quota.
AI_PROVIDER_RPM=
AI_PROVIDER_INPUT_TPM=
AI_PROVIDER_OUTPUT_TPM=
# Optional bounded product controls. Blank values retain documented defaults.
AI_CREATE_PER_MINUTE=
AI_CREATE_BURST=
AI_FRESH_PER_MINUTE=
AI_FRESH_PER_DAY=
AI_ACTOR_CONCURRENCY=
AI_GLOBAL_CONCURRENCY=
AI_DEADLINE_MS=
AI_REPAIRS=
AI_REJECTION_RETRIES=
AI_POLLS_PER_MINUTE=
AI_SSE_CONNECTIONS_PER_ACTOR=
AI_CACHE_TTL_MS=
AI_CACHE_ENTRIES=
AI_CACHE_ACTOR_ENTRIES=
AI_CACHE_BYTES=
AI_CACHE_ACTOR_BYTES=
