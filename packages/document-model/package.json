{
  "name": "@archboard/document-model",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretest": "pnpm --filter @archboard/contracts build && pnpm --filter @archboard/fixtures build",
    "test": "vitest run --passWithNoTests",
    "pretypecheck": "pnpm --filter @archboard/contracts build && pnpm --filter @archboard/fixtures build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@archboard/contracts": "workspace:*",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@archboard/fixtures": "workspace:*"
  }
}
